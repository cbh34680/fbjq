# /lib/systemd/system/system/fbjq-delivery.service
[Unit]
Description=FBJQ delivery Worker for Queue /var/spool/fbjq/delivery

[Service]
Type=oneshot
Slice=system.slice
RuntimeDirectory=fbjq

# == DEBUG ==
ExecStart=/root/work/fbjq/build/debug/delivery/fbjq-delivery
## == RELEASE ==
#ExecStart=/usr/local/bin/fbjq-delivery

# == security ==
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictNamespaces=yes
