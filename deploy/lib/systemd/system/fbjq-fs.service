#/lib/systemd/system/system/fbjq-fs.service
[Unit]
Description=FBJQ Filesystem Service

[Service]
Type=simple
Slice=system.slice
RuntimeDirectory=fbjq

# == DEBUG ==
ExecStart=/root/work/fbjq/build/debug/fs/fbjq-fs
## == RELEASE ==
#ExecStart=/usr/local/bin/fbjq-fs

# == security ==
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictNamespaces=yes

[Install]
WantedBy=multi-user.target
