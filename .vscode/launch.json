{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "fs Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/fs/fbjq-fs",
            "args": [
                "-c", "${workspaceFolder}/deploy/etc/fbjq.conf",
                "-f",
                "-d",
                "-o", "allow_other",
                "-o", "default_permissions",
                "-o", "fsname=fbjq-fs",
                "-o", "auto_unmount",
                "/run/fbjq",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Pass SIGINT directly to the application without stopping in the debugger",
                    "text": "handle SIGINT pass nostop noprint",
                    "ignoreFailures": true
                },
                {
                    "description": "Pass SIGTERM directly to the application without stopping in the debugger",
                    "text": "handle SIGTERM pass nostop noprint",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build-fs"
        },
        {
            "name": "delivery Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/delivery/fbjq-delivery",
            "args": [
                "-c", "${workspaceFolder}/deploy/etc/fbjq.conf",
                "-n", "10",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Pass SIGINT directly to the application without stopping in the debugger",
                    "text": "handle SIGINT pass nostop noprint",
                    "ignoreFailures": true
                },
                {
                    "description": "Pass SIGTERM directly to the application without stopping in the debugger",
                    "text": "handle SIGTERM pass nostop noprint",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build-delivery"
        },
        {
            "name": "executor Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/executor/fbjq-executor",
            "args": [
                "-c", "${workspaceFolder}/deploy/etc/fbjq.conf",
                "-q", "alice",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Pass SIGINT directly to the application without stopping in the debugger",
                    "text": "handle SIGINT pass nostop noprint",
                    "ignoreFailures": true
                },
                {
                    "description": "Pass SIGTERM directly to the application without stopping in the debugger",
                    "text": "handle SIGTERM pass nostop noprint",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build-executor"
        }
    ]
}
